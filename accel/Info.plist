<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>NVMetalAccel</string>
	<key>CFBundleIdentifier</key>
	<string>io.github.kvarun-p.nvmetalaccel</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>NVMetalAccel</string>
	<key>CFBundlePackageType</key>
	<string>KEXT</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>0.1.0</string>
	<key>IOKitPersonalities</key>
	<dict>
		<key>NVMetalAccelerator</key>
		<dict>
			<key>CFBundleIdentifier</key>
			<string>io.github.kvarun-p.nvmetalaccel</string>
			<key>IOClass</key>
			<string>NVMetalAccelerator</string>
			<!-- On IOResources, not on NVBringup: an accelerator below the GPU's PCI device makes
			     WindowServer's GPUWrangler adopt the GPU as a display GPU, which blanks the screen.
			     probe() requires NVBringup's service. -->
			<key>IOProviderClass</key>
			<string>IOResources</string>
			<key>IOResourceMatch</key>
			<string>IOKit</string>
			<key>IOMatchCategory</key>
			<string>IOAccelerator</string>
			<!-- Refused while NVBringup's NVDisplayPipeArmed is set (probe()): the display-pipe personality below
			     then owns the GPU. -->
			<!-- What Metal.framework loads for this accelerator: NVMetal.bundle, principal class
			     NVMetalDevice (a subclass of MTLIOAccelDevice). -->
			<key>MetalPluginName</key>
			<string>NVMetal</string>
			<key>MetalPluginClassName</key>
			<string>NVMetalDevice</string>
			<key>IOProbeScore</key>
			<integer>1000</integer>
		</dict>
		<!-- S1 display pipe (boot-arg nvdpipe=1, or the nvdpipe-once NVRAM gate, which NVBringup arms): the GPU's
		     PCI device, so NVBringup's NVDisplayNub and NVFramebuffer sit at depth <= 2 under it (S0-1). Starts
		     only while NVBringup on this device has NVDisplayPipeArmed = true (probe()). Probe score 1000 is well
		     below NVBringup's 30000, so NVBringup has started and set the gate first.
		     No MetalPluginName / MetalPluginClassName here: S1 runs without Metal (S2 adds them). -->
		<key>NVMetalDisplayPipe</key>
		<dict>
			<key>CFBundleIdentifier</key>
			<string>io.github.kvarun-p.nvmetalaccel</string>
			<key>IOClass</key>
			<string>NVMetalAccelerator</string>
			<key>IOProviderClass</key>
			<string>IOPCIDevice</string>
			<!-- NVIDIA (0x10de), any device -->
			<key>IOPCIMatch</key>
			<string>0x000010de&amp;0x0000ffff</string>
			<!-- Vendor only, like NVBringup: no IOPCIClassMatch. Hackintosh configs commonly spoof the dGPU's
			     class-code to 0xff0000 (OpenCore DeviceProperties) to hide it from macOS, and this laptop's does,
			     so a display-class match never reaches probe(). probe() requires NVBringup on the device. -->
			<key>IOMatchCategory</key>
			<string>IOAccelerator</string>
			<key>IOAccelRevision</key>
			<integer>2</integer>
			<!-- read by IOAcceleratorFamily2's copyCapabilities; IOPresentment refuses the pipe without it -->
			<key>IOAccelDisplayPipeCapabilities</key>
			<dict>
				<key>DisplayPipeSupported</key>
				<true/>
				<key>TransactionsSupported</key>
				<true/>
			</dict>
			<key>IOProbeScore</key>
			<integer>1000</integer>
		</dict>
	</dict>
	<key>OSBundleLibraries</key>
	<dict>
		<key>com.apple.iokit.IOAcceleratorFamily2</key>
		<string>2.0.0</string>
		<key>com.apple.kpi.iokit</key>
		<string>19.0</string>
		<key>com.apple.kpi.libkern</key>
		<string>19.0</string>
		<key>com.apple.kpi.mach</key>
		<string>19.0</string>
		<key>com.apple.kpi.unsupported</key>
		<string>19.0</string>
	</dict>
</dict>
</plist>
