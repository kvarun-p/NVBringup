<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>NVFramebuffer</string>
	<key>CFBundleIdentifier</key>
	<string>io.github.kvarun-p.nvframebuffer</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>NVFramebuffer</string>
	<key>CFBundlePackageType</key>
	<string>KEXT</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>0.1.0</string>
	<key>IOKitPersonalities</key>
	<dict>
		<!-- NVBringup publishes an NVDisplayNub while a display is lit, and only with boot-arg nvfb=1 or nvdpipe=1
		     or, for one boot, the NVRAM variable nvfb-once / nvdpipe-once. The nub is a client of the GPU's
		     IOPCIDevice (NVBringup is another client of the same device, and owns the nub), so it sits one
		     level below the PCI device, where IOAccelDisplayMachine and GPUWrangler look for framebuffers.
		     The nub carries NVDisplayFB. Armed with nvdpipe, the nub is up from boot (lit or not) and carries
		     Online too; NVBringup updates it in place on a hot-plug (kNVDisplayMsgState). -->

		<key>NVFramebuffer</key>
		<dict>
			<key>CFBundleIdentifier</key>
			<string>io.github.kvarun-p.nvframebuffer</string>
			<key>IOClass</key>
			<string>NVFramebuffer</string>
			<key>IOProviderClass</key>
			<string>NVDisplayNub</string>
			<key>IOMatchCategory</key>
			<string>IOFramebuffer</string>
		</dict>
	</dict>
	<key>OSBundleLibraries</key>
	<dict>
		<key>com.apple.iokit.IOGraphicsFamily</key>
		<string>1.0.0b1</string>
		<key>com.apple.kpi.iokit</key>
		<string>19.0</string>
		<key>com.apple.kpi.libkern</key>
		<string>19.0</string>
		<key>com.apple.kpi.mach</key>
		<string>19.0</string>
	</dict>
</dict>
</plist>
