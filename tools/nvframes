#!/usr/bin/env python3
"""nvframes: the display pipe's frame timing, printed as it changes. A text readout, not an overlay; no privileges.

  tools/nvframes [-i SECONDS] [-n COUNT]

NVBringup publishes two registry properties on the display pipe: NVPipeFlips (the flip count, every 120 flips) and
NVPipeTiming (the last 120 flips: copy, queue, latch-in and gap, as mean/max us, and the slow copies). This polls them
with ioreg every interval (default 1 s) and prints a line each time they change: flips per second from the 120-flip
windows, and the timing line as published. NVPipeSubmits is not published by this tree, so it is not read.
Times are the poll's clock, so with a 1 s interval the rate is good to about one window in two seconds.
"""
import argparse
import re
import subprocess
import sys
import time

FLIPS_RE = re.compile(r'"NVPipeFlips" = "(\d+) flips')
TIMING_RE = re.compile(r'"NVPipeTiming" = "([^"]*)"')


def read_props():
    """the two properties from NVBringup's registry entries, or None when the driver isn't loaded"""
    out = subprocess.run(["/usr/sbin/ioreg", "-r", "-c", "NVBringup", "-l", "-w0"],
                         stdout=subprocess.PIPE, stderr=subprocess.DEVNULL).stdout.decode("utf-8", "replace")
    if '"NVBringup"' not in out and "NVPipeTiming" not in out and "NVPipeFlips" not in out:
        return None
    flips = FLIPS_RE.search(out)
    timing = TIMING_RE.search(out)
    return (int(flips.group(1)) if flips else None, timing.group(1) if timing else None)


def main(argv):
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("-i", "--interval", type=float, default=1.0)
    ap.add_argument("-n", "--count", type=int, default=0, help="polls to make (0: until Ctrl-C)")
    args = ap.parse_args(argv)
    last_timing, last_change = None, None
    polls = 0
    try:
        while not args.count or polls < args.count:
            polls += 1
            props = read_props()
            now = time.monotonic()
            if props is None:
                print("NVBringup is not loaded (no NVPipeTiming / NVPipeFlips)")
            else:
                flips, timing = props
                if timing and timing != last_timing:
                    rate = ""
                    if last_change is not None:
                        rate = "  %.1f flips/s (120-flip window %.2f s)" % (120.0 / (now - last_change),
                                                                          now - last_change)
                    print("%s  %s%s" % (time.strftime("%H:%M:%S"), timing, rate))
                    last_timing, last_change = timing, now
                if timing is None and flips is not None:
                    print("%s  %d flips (no timing published yet)" % (time.strftime("%H:%M:%S"), flips))
            sys.stdout.flush()
            if args.count and polls >= args.count:
                break
            time.sleep(args.interval)
    except KeyboardInterrupt:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
