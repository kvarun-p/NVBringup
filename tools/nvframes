#!/usr/bin/env python3
"""nvframes: the display pipe's frame timing, printed as it changes. A text readout, not an overlay; no privileges.

  tools/nvframes [-i SECONDS] [-n COUNT]

NVBringup publishes two registry properties on the display pipe: NVPipeFlips (the flip count, every 120 flips) and
NVPipeTiming (the last 120 flips: copy, queue, latch-in and gap, as mean/max us, and the slow copies). This polls them
with ioreg every interval (default 1 s) and prints a line each time they change: flips per second from the 120-flip
windows, and the timing line as published. NVMetalAccelerator's counters (NVPipeSubmits, NVPipeGpuCopies,
NVPipeCpuCopies) give WindowServer's submissions per second and how many frames fell back to the CPU copy.
With zero-copy scanout (boot-arg nvzerocopy=1) the line also shows ZeroCopyFlips, the frames scanned out in place with
no copy, ZeroCopyFallbacks (frames the kext refused, copied instead) and ZeroCopyLastResult (why: 2 not registered,
3 stale seed, 4 geometry, 5 too many images held, 1 not ready), and NVBringup's NVZeroCopy line when it changes.
Times are the poll's clock, so with a 1 s interval the rate is good to about one window in two seconds.
"""
import argparse
import re
import subprocess
import sys
import time

FLIPS_RE = re.compile(r'"NVPipeFlips" = "(\d+) flips')
TIMING_RE = re.compile(r'"NVPipeTiming" = "([^"]*)"')
ACCEL_KEYS = ("NVPipeSubmits", "NVPipeGpuCopies", "NVPipeCpuCopies", "ZeroCopyFlips", "ZeroCopyFallbacks",
              "ZeroCopyLastResult")
ACCEL_RE = {k: re.compile(r'"%s" = (\d+)' % k) for k in ACCEL_KEYS}
ZEROCOPY_RE = re.compile(r'"NVZeroCopy" = "([^"]*)"')


def read_accel():
    """NVMetalAccelerator's display pipe counters, or {} when it isn't loaded"""
    out = subprocess.run(["/usr/sbin/ioreg", "-r", "-c", "NVMetalAccelerator", "-d", "1", "-l", "-w0"],
                         stdout=subprocess.PIPE, stderr=subprocess.DEVNULL).stdout.decode("utf-8", "replace")
    return {k: int(m.group(1)) for k, r in ACCEL_RE.items() for m in [r.search(out)] if m}


def read_zerocopy():
    """NVBringup's NVZeroCopy line (flips and refusals by reason), or None before the first zero-copy flip"""
    out = subprocess.run(["/usr/sbin/ioreg", "-r", "-c", "NVBringup", "-l", "-w0"],
                         stdout=subprocess.PIPE, stderr=subprocess.DEVNULL).stdout.decode("utf-8", "replace")
    m = ZEROCOPY_RE.search(out)
    return m.group(1) if m else None


def read_props():
    """the two properties from NVBringup's registry entries, or None when the driver isn't loaded"""
    out = subprocess.run(["/usr/sbin/ioreg", "-r", "-c", "NVBringup", "-l", "-w0"],
                         stdout=subprocess.PIPE, stderr=subprocess.DEVNULL).stdout.decode("utf-8", "replace")
    if '"NVBringup"' not in out and "NVPipeTiming" not in out and "NVPipeFlips" not in out:
        return None
    flips = FLIPS_RE.search(out)
    timing = TIMING_RE.search(out)
    return (int(flips.group(1)) if flips else None, timing.group(1) if timing else None)


def main(argv):
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("-i", "--interval", type=float, default=1.0)
    ap.add_argument("-n", "--count", type=int, default=0, help="polls to make (0: until Ctrl-C)")
    args = ap.parse_args(argv)
    last_timing, last_change = None, None
    last_accel, last_accel_at = None, None
    last_zc = None
    polls = 0
    try:
        while not args.count or polls < args.count:
            polls += 1
            props = read_props()
            now = time.monotonic()
            if props is None:
                print("NVBringup is not loaded (no NVPipeTiming / NVPipeFlips)")
            else:
                flips, timing = props
                if timing and timing != last_timing:
                    rate = ""
                    if last_change is not None:
                        rate = "  %.1f flips/s (120-flip window %.2f s)" % (120.0 / (now - last_change),
                                                                          now - last_change)
                    print("%s  %s%s" % (time.strftime("%H:%M:%S"), timing, rate))
                    last_timing, last_change = timing, now
                if timing is None and flips is not None:
                    print("%s  %d flips (no timing published yet)" % (time.strftime("%H:%M:%S"), flips))
            accel = read_accel()
            if accel and last_accel is not None and accel.get("NVPipeSubmits", 0) != last_accel.get("NVPipeSubmits", 0):
                dt = now - last_accel_at
                d = {k: accel.get(k, 0) - last_accel.get(k, 0) for k in accel}
                # the copy counters are published in batches (every 60 frames): totals, not per interval
                line = "%s  submits %.1f/s; copies so far by GPU %d, by CPU %d" % (time.strftime("%H:%M:%S"),
                      d.get("NVPipeSubmits", 0) / dt, accel.get("NVPipeGpuCopies", 0), accel.get("NVPipeCpuCopies", 0))
                if "ZeroCopyFlips" in accel or "ZeroCopyFallbacks" in accel:
                    # zero-copy: flips scanned out in place (a rate), refusals so far and the last reason
                    line += "; zero-copy flips %.1f/s (%d so far), fallbacks %d (last reason %d)" % (
                        d.get("ZeroCopyFlips", 0) / dt, accel.get("ZeroCopyFlips", 0),
                        accel.get("ZeroCopyFallbacks", 0), accel.get("ZeroCopyLastResult", 0))
                print(line)
                zc = read_zerocopy()
                if zc and zc != last_zc:
                    print("%s  NVBringup NVZeroCopy: %s" % (time.strftime("%H:%M:%S"), zc))
                    last_zc = zc
            if accel:
                last_accel, last_accel_at = accel, now
            sys.stdout.flush()
            if args.count and polls >= args.count:
                break
            time.sleep(args.interval)
    except KeyboardInterrupt:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
